<launch>
    <arg name="map_file" default="$(find-pkg-share nav_goal_bridge_pkg)/config/map01.yaml"/>
    <arg name="params_file" default="$(find-pkg-share nav_goal_bridge_pkg)/config/mapper_params.yaml"/>
    <arg name="use_sim_time" default="True"/>

    <include file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
        <arg name="map" value="$(var map_file)"/>
        <arg name="use_sim_time" value="$(var use_sim_time)"/>
        <arg name="params_file" value="$(var params_file)"/>
        <arg name="autostart" value="true"/>
    </include>
</launch>
