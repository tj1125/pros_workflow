# ============================================================
# VLM Grasp System - Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- VLM Provider ---
# Options: google | ollama
VLM_PROVIDER=google

# Google Gemini API Key (required if VLM_PROVIDER=google)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-2.0-flash

# Ollama (required if VLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_CLASSIFIER_MODEL=gemma3:1b
OLLAMA_CHAT_MODEL=gemma4:26b

# --- System Mode ---
# Set to true to run in mock mode (no VLM or GPU calls)
MOCK_MODE=true

# --- RTX 3090 Inference Servers (A2A Servers) ---
# Set these to the actual IP:Port of your GPU inference servers.
# Main graph requires find/item-info/grasp in real mode.
INF_FIND_URL=http://192.168.1.10:8005
INF_GET_ITEM_INFO_NO_SAM3D_URL=http://192.168.1.10:8006
INF_GET_ITEM_INFO_URL=
INF_GRASP_URL=http://192.168.1.10:8007

# --- Rosbridge (Unity Digital Twin) ---
ROSBRIDGE_URL=ws://localhost:9090

# --- ROS 2 Runtime (camera / nav subprocesses) ---
ROS_DOMAIN_ID=1
ROS_PYTHON_BIN=/usr/bin/python3
ROS_SETUP_BASH=/opt/ros/humble/setup.bash
ROS_OVERLAY_SETUP_BASH=/workspaces/install/setup.bash

# --- Navigation / world-position refresh ---
WORLD_POSITION_UPDATE_THRESHOLD_M=0.3
NAV_PLAN_TIMEOUT_SEC=8
NAV_ARRIVAL_TIMEOUT_SEC=180
NAV_PUBLISH_INTERVAL_SEC=0.1
NAV_SAME_RANK_RETRIES=0
APPROACH_AGENT_TIMEOUT_SEC=420

# --- Web UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Logging ---
TRACE_LOG_FILE=logs/trace_logger.jsonl
