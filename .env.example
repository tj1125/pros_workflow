# ============================================================
# VLM-RL Grasp System - Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- VLM Provider ---
# Options: google | ollama
VLM_PROVIDER=google

# Google Gemini API Key (required if VLM_PROVIDER=google)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model name
GEMINI_MODEL=gemini-2.0-flash

# Ollama (required if VLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# --- System Mode ---
# Set to true to run in mock mode (no VLM or GPU calls)
MOCK_MODE=true

# --- RTX 3090 Inference Servers (A2A Servers) ---
# Set these to the actual IP:Port of your GPU inference servers
INF_NAV_URL=http://192.168.1.10:9001
INF_GRASP_URL=http://192.168.1.10:9002
INF_VIEW_URL=http://192.168.1.10:9003

# --- Rosbridge (Unity Digital Twin) ---
ROSBRIDGE_URL=ws://localhost:9090

# --- Logging ---
TRACE_LOG_FILE=trace_logger.jsonl
