# ==============================================================================
# pros_workflow environment template.
#   cp .env.example .env      then fill in <ollama-host> / <gpu-host>.
# The Commander loads .env from the project root at startup; the GPU services read the
# same file. The real .env is gitignored — keep secrets/IPs out of git.
# ==============================================================================

# --- ROS ---
ROS_DOMAIN_ID=1

# --- Ollama (VLM brain) ---
# OLLAMA_BASE_URL must be reachable from the Commander. The Commander runs in a
# container, so use the host LAN IP / docker-bridge gateway, NOT 127.0.0.1. The Ollama
# server must be started bound to all interfaces (OLLAMA_HOST=0.0.0.0), and the models
# below must be pulled on it (`ollama pull <model>`), or requests 404.
OLLAMA_BASE_URL=http://<ollama-host>:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_CLASSIFIER_MODEL=qwen2.5-coder:3b
OLLAMA_CHAT_MODEL=gemma3:12b

# --- GPU inference server IP (single source of truth) ---
# What the GPU A2A servers advertise in their AgentCard url (the address the Commander
# POSTs tasks back to). The INF_* URLs below derive from it, so set the IP ONLY here.
# Must be reachable from the Commander; in a container use host LAN IP / bridge gateway,
# NOT 127.0.0.1. Default when unset is 127.0.0.1 (fine only for same-host tests).
EXTERNAL_IP=<gpu-host>

# --- GPU A2A inference services (host derived from EXTERNAL_IP above; dotenv expands ${…}) ---
INF_GET_ITEM_INFO_NO_SAM3D_URL=http://${EXTERNAL_IP}:8006
INF_GRASP_URL=http://${EXTERNAL_IP}:8007
# INF_GET_ITEM_INFO_URL=http://${EXTERNAL_IP}:8008   # legacy SAM3D; leave empty/unset to disable

# --- Optional tunables (defaults work; uncomment to override) ---
# WEB_HOST=0.0.0.0                    # web UI bind host
# WEB_PORT=8080                       # web UI port
# WEB_KEEP_LOGS=1                     # keep logs/ instead of clearing on shutdown
# TRACE_LOG_FILE=logs/trace.jsonl     # commander trace log path
# GET_ITEM_INFO_LEGACY_PORT=8008      # (GPU server side) legacy SAM3D :8008 port
