# HIP build artifacts generated by hipify during the AMD ROCm build (regenerated on
# every `pip install -e .`; not source).
pointnet2_ops/_ext-src/src/*_hip.cpp
pointnet2_ops/_ext-src/src/*_gpu.hip
pointnet2_ops/_ext-src/include/hip_utils.h
pointnet2_ops/_ext-src/include/utils_hip.h

# compiled extension + build dirs
pointnet2_ops/_ext*.so
build/
*.egg-info/
